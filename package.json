{
  "name": "rathin-website",
  "private": true,
  "version": "1.0.0",
  "description": "RATHIN - Manufacturing Innovation. Static React + TypeScript website for a commercial induction kitchen equipment manufacturer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "build:spa": "vite build",
    "prerender": "node scripts/prerender.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-icons": "^5.3.0",
    "react-router-dom": "^6.28.0",
    "swiper": "^11.1.15"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
